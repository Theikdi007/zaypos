// Google Sign-In (docs/backend/auth-google.md §6). The iOS OAuth client id REVERSED:
// client id  123-abc.apps.googleusercontent.com  →  com.googleusercontent.apps.123-abc
// It is the URL scheme Google redirects back to (Info.plist CFBundleURLTypes).
// The real value lives in GoogleSignIn.local.xcconfig (gitignored; REVERSED_CLIENT_ID from
// GoogleService-Info.plist). Without it the placeholder below is used and the app says Google is not configured.
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.not-configured
#include? "GoogleSignIn.local.xcconfig"
