{
  "Jwt": {
    "Issuer": "zaypos",
    "Audience": "zaypos-app",
    "AccessTokenMinutes": 15
  },
  "RateLimiting": {
    "AuthPerIpPerMinute": 120,
    "AuthPerPhonePerMinute": 10
  },
  "ForwardedHeaders": {
    "Enabled": true,
    "TrustedNetworks": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
