# ZayPOS production secrets. Copy to the SERVER as /home/deploy/zaypos/.env and chmod 600.
# Never commit .env (deploy/.gitignore blocks it). Values: no spaces, no quotes.
# Generate each password with:   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# (letters + digits only: valid for SQL Server's password policy and safe in connection strings)

# --- Compose (leave as is) ---
COMPOSE_FILE=docker-compose.prod.yml
API_DOMAIN=api.zaypos.app
# Set by release.sh on every deploy/rollback. Do not edit by hand.
API_TAG=
# uid/gid of the deploy user (`id -u` / `id -g` as deploy): Caddy runs as it and keeps its certificates in caddy-data/ (0700).
# Vultr's image already has uid 1000 (linuxuser), so deploy is usually 1001.
DEPLOY_UID=<id -u>
DEPLOY_GID=<id -g>

# --- SQL Server ---
# sa: only SQL Server itself, the migrate step and backup/restore use it. Never the API.
MSSQL_SA_PASSWORD=<generate>
# The API's own login (zaypos_app: read/write data, no schema changes). Created by the migrate step.
DB_APP_PASSWORD=<generate>

# --- Auth ---
# JWT signing key, 48 random bytes:   openssl rand -base64 48 | tr -d '\n'
# Changing it signs every phone out (they sign in again with their PIN).
JWT_SIGNING_KEY=<generate>

# Google sign-in (docs/backend/auth-google.md) → Auth:Google:ClientIds. Every OAuth client id whose
# ID tokens the API accepts, comma-separated: web (server) client, Android debug + release, iOS.
GOOGLE_CLIENT_IDS=<web-client-id>,<android-release-client-id>,<ios-client-id>
# SMS OTP phone verification → Auth:OtpEnabled. false = no SMS is ever sent and the SMS settings below
# are ignored. Set true once the SMSPoh Sender ID is approved.
AUTH_OTP_ENABLED=false

# --- SMS (OTP codes, only with AUTH_OTP_ENABLED=true) --- → Sms:Provider, Sms:SmsPoh:*
# SmsPoh = real SMS. Console = NO SMS: the code is written to the API log (read it with
#   docker compose logs api | grep 'DEV SMS'). Only until SMSPoh is ready: anyone who can read the
#   logs can sign in to any shop. The API logs a CRITICAL warning at every start while it is on.
SMS_PROVIDER=SmsPoh
# SMSPoh v3 API credential (dashboard → Accounts & Security → API Credentials), pasted as shown there.
# The API builds the Bearer value itself (base64 of "key:secret"). May stay empty with Console.
SMSPOH_API_KEY=
SMSPOH_API_SECRET=
# Alternative to the two lines above: the ready Bearer value. Leave empty when they are set.
SMSPOH_TOKEN=
# Sender ID approved on your SMSPoh account (case-sensitive). Empty = account default.
SMSPOH_SENDER=
# true = SMSPoh accepts but does not deliver (first smoke test only). Must be false for real use.
SMSPOH_TEST=false

# --- Nightly backups → Cloudflare R2 (S3 API) ---
R2_ACCOUNT_ID=<Cloudflare account id>
R2_BACKUP_BUCKET=zaypos-backups
# R2 API token scoped to the backup bucket only, "Object Read & Write".
R2_BACKUP_ACCESS_KEY_ID=<from R2>
R2_BACKUP_SECRET_ACCESS_KEY=<from R2>
BACKUP_RETENTION_DAYS=30
# Optional: URL pinged after every successful backup (e.g. a healthchecks.io check). Empty = off.
BACKUP_PING_URL=

# --- Subscription payment screenshots → R2 (optional, separate bucket + token) ---
APP_R2_ACCOUNT_ID=
APP_R2_ACCESS_KEY_ID=
APP_R2_SECRET_ACCESS_KEY=
APP_R2_BUCKET=
