# Caddy: api.zaypos.app directly (no Cloudflare proxy), TLS from Let's Encrypt, then → api:8080.
#
# Why not behind Cloudflare: Myanmar networks without a VPN cut TLS connections to Cloudflare-proxied hosts
# (ERR_CONNECTION_CLOSED on a phone on home Wi-Fi, 2026-11-20), so the app could not reach the API. The
# website (zaypos.app, Cloudflare Pages) is unaffected by this file. DNS: the "api" record is DNS only.
#
# Caddy runs as the deploy user (no root, no capabilities), so it listens on unprivileged ports inside the
# container; docker-compose publishes them as 80 → 8000 and 443 → 8443. Certificates and the ACME account
# live in ./caddy-data (persisted: re-issuing on every restart would hit Let's Encrypt's rate limits).
{
	admin off
	persist_config off
	http_port 8000
	https_port 8443
	# Let's Encrypt only (HTTP-01 on 80, TLS-ALPN-01 on 443): its chain (ISRG Root X1) is trusted from
	# Android 7.1.1, so the oldest supported phones (Android 8) accept it.
	cert_issuer acme

	servers {
		protocols h1 h2
		# No trusted_proxies: every client connects directly, so {remote_host} is the real client address
		# and any X-Forwarded-For / CF-Connecting-IP it sends is not believed.
	}

	log {
		output stdout
		format json
	}
}

# http://api.zaypos.app → https:// (automatic), plus the ACME HTTP-01 challenge.
{$API_DOMAIN} {
	tls {
		protocols tls1.2 tls1.3
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	request_body {
		max_size 32MB
	}

	reverse_proxy api:8080 {
		# X-Forwarded-For / -Proto: Caddy's default, with no trusted_proxies, REPLACES what the client sent with
		# {remote_host} / https. The API believes them from Caddy only (ForwardedHeaders:TrustedNetworksOverride).
		# Headers the API used to read from Cloudflare are dropped, so a client can't plant them.
		header_up -CF-Connecting-IP
		header_up -X-Real-IP
		header_up -Forwarded
		transport http {
			dial_timeout 5s
		}
	}

	log {
		output stdout
		format json
	}
}
